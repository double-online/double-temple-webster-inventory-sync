# Shopify Dev Dashboard app (Settings → Credentials)
# Store subdomain only, without .myshopify.com
# Client credentials cannot mint a token for this production store.
# After these are set, add http://localhost:3456/callback to the app's
# allowed redirection URLs, release that version, then run: npm run auth
SHOPIFY_STORE_NAME=your_shopify_store_name
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Application Settings
SUPPLIER_ID=your_supplier_id
RESULTS_PER_PAGE=250

# FTP Configuration
FTP_HOST=your_ftp_host
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_REMOTE_PATH=/